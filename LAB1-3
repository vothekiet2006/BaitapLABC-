using System;
using System.Collections;
using System.Collections.Generic;

namespace ProductInventorySystem
{
    // =========================================================================
    // 1. ĐỊNH NGHĨA LỚP PRODUCT (Yêu cầu 1 & 2)
    // =========================================================================
    public class Product
    {
        public string Id { get; set; }
        public string Name { get; set; }
        public double Price { get; set; }
        public int Quantity { get; set; }

        public Product(string id, string name, double price, int quantity)
        {
            Id = id;
            Name = name;
            Price = price;
            Quantity = quantity;
        }

        // Yêu cầu 2: Method GetTotalValue() tính giá trị tồn kho của sản phẩm này
        public double GetTotalValue()
        {
            return Price * Quantity;
        }

        public override string ToString()
        {
            return $"ID: {Id,-5} | Tên: {Name,-15} | Giá: {Price,-6} | SL: {Quantity,-4} | Tổng Giá Trị: {GetTotalValue()}";
        }
    }

    // =========================================================================
    // 2. CÂU HỎI 02: NÂNG CAO - CLASS INVENTORY IMPLEMENT IEnumerable<Product>
    // =========================================================================
    // A1: Tạo class Inventory kế thừa giao diện IEnumerable<Product> để cho phép duyệt foreach trực tiếp
    public class Inventory : IEnumerable<Product>
    {
        private List<Product> products = new List<Product>();

        // Phương thức bổ trợ để thêm sản phẩm vào kho
        public void AddProduct(Product product)
        {
            if (product != null)
            {
                products.Add(product);
            }
        }

        // A2: Viết method UpdateStock() cập nhật số lượng theo Id sản phẩm
        public bool UpdateStock(string id, int newQuantity)
        {
            foreach (var product in products)
            {
                if (product.Id.Equals(id, StringComparison.OrdinalIgnoreCase))
                {
                    product.Quantity = newQuantity;
                    return true; // Cập nhật thành công
                }
            }
            return false; // Không tìm thấy Id sản phẩm
        }

        // Bắt buộc thực hiện 2 phương thức của giao diện IEnumerable để kích hoạt foreach bên ngoài lớp
        public IEnumerator<Product> GetEnumerator()
        {
            return products.GetEnumerator();
        }

        IEnumerator IEnumerable.GetEnumerator()
        {
            return this.GetEnumerator();
        }

        // ---------------------------------------------------------------------
        // CÂU HỎI 01: CÁC PHƯƠNG THỨC LOGIC TRUY VẤN KHO
        // ---------------------------------------------------------------------
        
        // Q1: Tìm sản phẩm tồn kho thấp hơn ngưỡng cho trước
        public List<Product> GetLowStockProducts(int threshold)
        {
            List<Product> lowStockList = new List<Product>();
            foreach (var product in products)
            {
                if (product.Quantity < threshold)
                {
                    lowStockList.Add(product);
                }
            }
            return lowStockList;
        }

        // Q2: Tính tổng giá trị toàn bộ kho hàng
        public double CalculateTotalInventoryValue()
        {
            double totalValue = 0;
            foreach (var product in products)
            {
                totalValue += product.GetTotalValue();
            }
            return totalValue;
        }

        // Q3: Tìm sản phẩm có giá trị tồn kho cao nhất (Price * Quantity cao nhất)
        public Product GetHighestValueProduct()
        {
            if (products.Count == 0) return null;

            Product highestValueProduct = products[0];
            foreach (var product in products)
            {
                if (product.GetTotalValue() > highestValueProduct.GetTotalValue())
                {
                    highestValueProduct = product;
                }
            }
            return highestValueProduct;
        }
    }

    // =========================================================================
    // 3. HÀM MAIN CHẠY VÀ KIỂM TRA TOÀN BỘ CHƯƠNG TRÌNH
    // =========================================================================
    class Program
    {
        static void Main(string[] args)
        {
            // Thiết lập hiển thị tiếng Việt trên màn hình Console
            Console.OutputEncoding = System.Text.Encoding.UTF8;

            // Khởi tạo đối tượng quản lý kho
            Inventory myInventory = new Inventory();

            // Yêu cầu 3: Tạo và nạp 5 sản phẩm mẫu vào danh sách kho
            myInventory.AddProduct(new Product("P01", "Laptop ASUS", 15000, 5));
            myInventory.AddProduct(new Product("P02", "Chuột Logitech", 500, 25));
            myInventory.AddProduct(new Product("P03", "Bàn phím Cơ", 1200, 8));
            myInventory.AddProduct(new Product("P04", "Màn hình Dell", 4500, 3));
            myInventory.AddProduct(new Product("P05", "Tai nghe Sony", 2000, 12));

            // -----------------------------------------------------------------
            // A3: Sử dụng vòng lặp foreach để duyệt qua đối tượng Inventory
            // -----------------------------------------------------------------
            Console.WriteLine("====== DANH SÁCH SẢN PHẨM HIỆN TẠI TRONG KHO (Duyệt qua IEnumerable) ======");
            foreach (Product prod in myInventory)
            {
                Console.WriteLine(prod);
            }

            // -----------------------------------------------------------------
            // TEST CÂU HỎI 01
            // -----------------------------------------------------------------
            Console.WriteLine("\n====== KIỂM TRA CÂU HỎI 01 ======");

            // Test Q1: Tìm sản phẩm có số lượng < 10 sản phẩm
            int threshold = 10;
            Console.WriteLine($"Q1. Các sản phẩm có số lượng tồn kho thấp hơn ngưỡng ({threshold}):");
            List<Product> lowStock = myInventory.GetLowStockProducts(threshold);
            foreach (var prod in lowStock)
            {
                Console.WriteLine($"   -> {prod.Name} (Còn lại: {prod.Quantity})");
            }

            // Test Q2: Tính tổng toàn bộ giá trị kho hàng
            double totalWarehouseValue = myInventory.CalculateTotalInventoryValue();
            Console.WriteLine($"\nQ2. Tổng giá trị của toàn bộ kho hàng: {totalWarehouseValue} USD");

            // Test Q3: Tìm sản phẩm có tổng giá trị lớn nhất
            Product topValueProd = myInventory.GetHighestValueProduct();
            Console.WriteLine($"\nQ3. Sản phẩm có tổng giá trị tồn kho lớn nhất là:\n   -> {topValueProd}");

            // -----------------------------------------------------------------
            // TEST CÂU HỎI 02 (A2: UpdateStock)
            // -----------------------------------------------------------------
            Console.WriteLine("\n====== KIỂM TRA CÂU HỎI 02 (CẬP NHẬT KHO) ======");
            string targetId = "P04";
            int updateQuantity = 15;
            
            Console.WriteLine($"[Thực hiện] Tiến hành cập nhật số lượng của sản phẩm {targetId} lên {updateQuantity} cái...");
            bool isUpdated = myInventory.UpdateStock(targetId, updateQuantity);

            if (isUpdated)
            {
                Console.WriteLine("=> Cập nhật thành công! Danh sách kho sau khi thay đổi:");
                foreach (Product prod in myInventory)
                {
                    Console.WriteLine(prod);
                }
                
                // Kiểm tra lại xem tổng giá trị kho có nhảy số mới không
                Console.WriteLine($"=> Tổng giá trị kho mới sau khi cập nhật: {myInventory.CalculateTotalInventoryValue()} USD");
            }
            else
            {
                Console.WriteLine($"=> [Lỗi] Không tìm thấy sản phẩm có mã {targetId} để cập nhật.");
            }

            Console.ReadLine();
        }
    }
}
